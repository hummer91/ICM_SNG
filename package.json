{
  "name": "icm-sng-poker",
  "version": "1.0.0",
  "description": "6인 SNG ICM 포커 학습 앱 - Push/Fold 전략 최적화",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "prepare": "husky install",
    "lint-staged": "lint-staged",
    "audit": "npm audit",
    "audit:fix": "npm audit fix",
    "licenses": "npx license-checker --production --summary",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "docs": "jsdoc -c jsdoc.config.json",
    "docs:watch": "nodemon --watch src --ext js -x npm run docs",
    "docs:all": "npm run docs && npm run build-storybook"
  },
  "keywords": [
    "poker",
    "icm",
    "sng",
    "tournament",
    "push-fold",
    "strategy"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/html": "^8.6.14",
    "@storybook/html-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-legacy": "^5.2.0",
    "@vitest/ui": "^3.2.4",
    "docdash": "^2.0.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.3",
    "happy-dom": "^18.0.1",
    "husky": "^8.0.3",
    "jsdoc": "^4.0.4",
    "lint-staged": "^15.2.0",
    "prettier": "^3.6.2",
    "storybook": "^8.6.14",
    "vite": "^5.0.12",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@sentry/browser": "^10.0.0",
    "@sentry/integrations": "^7.114.0",
    "chart.js": "^4.4.1",
    "posthog-js": "^1.258.5",
    "web-vitals": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md}": "prettier --write"
  }
}
